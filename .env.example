# Search and storage
VESPA_ENDPOINT=http://localhost:8080
# DATA_DIR=data
# DUCKDB_PATH=data/submissions_data.duckdb
# READ_ONLY_TABLE_PATTERNS=
# RECORD_ID_COLUMN=id

# LLM provider: "local" or "hosted"
LLM_PROVIDER=local
LLM_MODEL=qwen2.5:14b
# OLLAMA_HOST=http://localhost:11434

# Generic hosted /chat/completions endpoint
# LLM_PROVIDER=hosted
# LLM_BASE_URL=https://llm.example.com/v1
# LLM_API_KEY=
# LLM_HOSTED_MODEL=gpt-4.1

# Authentication. The application defaults to requiring authentication;
# these local-development values explicitly disable it.
REQUIRE_LOGIN=false
REQUIRE_API_AUTH=false
# OKTA_ISSUER=https://example.okta.com/oauth2/default
# OKTA_AUDIENCE=api://default

# Optional tracing
# LANGFUSE_HOST=http://localhost:3000
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Audit trail: "file", "s3", or "off"
AUDIT_SINK=file
# AUDIT_SPOOL_PATH=data/audit_spool.jsonl
# AUDIT_S3_BUCKET=
# AUDIT_S3_PREFIX=audit
# AUDIT_S3_REGION=
