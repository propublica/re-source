# Streamlit native OIDC authentication.
# Copy this file to .streamlit/secrets.toml and fill in your provider details.

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "CHANGE_ME_TO_A_RANDOM_SECRET"
client_id = "YOUR_CLIENT_ID"
client_secret = "YOUR_CLIENT_SECRET"
server_metadata_url = "https://YOUR_PROVIDER/.well-known/openid-configuration"
